# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Core ---
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@db:5432/amr_db
# Required when ENVIRONMENT=production. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins. In production use the exact web origin,
# for example https://rwangoga.github.io
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SQL_ECHO=false

# --- AI assistant (optional) ---
GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides (defaults in code: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Demo accounts (never enable in production) ---
# Without these, the first administrator must be provisioned directly in the
# database, then promoted with PUT /api/v1/admin/users/{id}/role.
SEED_DEMO_USERS=false
SEED_DOCTOR_PASSWORD=
SEED_ADMIN_PASSWORD=
