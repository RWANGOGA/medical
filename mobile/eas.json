      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://medical-sbit.onrender.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://medical-sbit.onrender.com/api/v1/chat/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}